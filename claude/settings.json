      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.gnupg/**)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/id_rsa*)",
      "Write(**/id_ed25519*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/auto-commit-on-stop.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/analyze-deviations.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "osascript -e 'display notification \"タスクが完了しました\" with title \"Claude Code\" sound name \"Glass\"' 2>/dev/null; printf '\\a' 2>/dev/null; exit 0",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/auto-compile-memory.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/guard-dangerous-bash.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/auto-codex-review.sh",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/auto-codex-review-on-push.sh",
            "timeout": 130
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/stylish-statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "shinkoku": {
      "source": {
        "source": "github",
        "repo": "kazukinagata/shinkoku"
      }
    }
  },
  "effortLevel": "xhigh",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "theme": "light-daltonized",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "skipDangerousModePermissionPrompt": true
}
